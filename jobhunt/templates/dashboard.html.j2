<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>{{ title }}</title>
<!-- The same mark as the header brand: the compass glyph on the accent square. Inline so
     the tab has an icon with no external request, from the server or the static file. -->
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%233557d6'/%3E%3Cg transform='translate(6 6) scale(0.8333)' fill='none' stroke='%23ffffff' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M12 3 3 21l9-5 9 5-9-18Z M12 3v13'/%3E%3C/g%3E%3C/svg%3E">
<style>
  :root { color-scheme:light; --bg:#f6f7f9; --surface:#ffffff; --surface2:#f1f3f6; --ink:#1f2633; --muted:#6b7484; --line:#e4e7ec; --line-strong:#c9cfd9; --accent:#3557d6; --accent-strong:#2a46b3; --on-accent:#ffffff; --tint:#edf1fd; --good:#1b7f5f; --good-bg:#e6f5ee; --warn:#9a6300; --warn-bg:#fff5db; --bad:#b83a4a; --bad-bg:#fdeef0; --shadow:0 10px 30px #1a233414; --radius:10px; }
  :root[data-theme="dark"] { color-scheme:dark; --bg:#0f141c; --surface:#171d27; --surface2:#1e2633; --ink:#e7ecf3; --muted:#9aa6b8; --line:#2a3342; --line-strong:#3a4557; --accent:#8ea4ff; --accent-strong:#a9b9ff; --on-accent:#0f141c; --tint:#242d44; --good:#6fd1ad; --good-bg:#173a30; --warn:#e9c069; --warn-bg:#3f3420; --bad:#f08e9b; --bad-bg:#442833; --shadow:0 10px 30px #0006; }
  * { box-sizing:border-box; }
  html:has(dialog:modal) { overflow:hidden; }
  body { margin:0; color:var(--ink); background:var(--bg); font:14px/1.5 "Segoe UI",system-ui,sans-serif; }
  button,input,select,textarea { font:inherit; }
  button,a,input,select,textarea { -webkit-tap-highlight-color:transparent; }
  button { cursor:pointer; }
  button:disabled { cursor:not-allowed; opacity:.45; }
  button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
  a { color:var(--accent); text-decoration:none; } a:hover { text-decoration:underline; }
  [hidden] { display:none!important; }
  .icon { width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; }
  /* Buttons: hover changes the background only. A filled button keeps its text colour, so the
     label never matches its own background (the old rule painted both the accent colour). */
  .btn { display:inline-flex; align-items:center; justify-content:center; gap:6px; min-height:34px; padding:6px 12px; border:1px solid var(--line); border-radius:8px; background:var(--surface); color:var(--ink); font-weight:550; font-size:12.5px; text-decoration:none; transition:background .12s,border-color .12s; }
  .btn:hover:not(:disabled) { background:var(--surface2); border-color:var(--line-strong); color:var(--ink); text-decoration:none; }
  .btn.primary { background:var(--accent); border-color:var(--accent); color:var(--on-accent); }
  .btn.primary:hover:not(:disabled) { background:var(--accent-strong); border-color:var(--accent-strong); color:var(--on-accent); }
  .btn.ghost { background:transparent; border-color:transparent; color:var(--muted); }
  .btn.ghost:hover:not(:disabled) { background:var(--surface2); border-color:transparent; color:var(--ink); }
  .btn.danger { color:var(--bad); }
  .btn.active { background:var(--tint); border-color:transparent; color:var(--accent); }
  .icon-btn { padding:6px; min-width:34px; }
  .topbar { position:sticky; top:0; z-index:20; background:var(--surface); border-bottom:1px solid var(--line); }
  .topbar-inner { max-width:1180px; margin:0 auto; padding:0 24px; display:flex; align-items:center; gap:16px; min-height:56px; }
  .brand { display:flex; align-items:center; gap:9px; font-weight:700; font-size:16px; letter-spacing:-.2px; white-space:nowrap; }
  .brand-mark { width:26px; height:26px; display:grid; place-items:center; border-radius:7px; background:var(--accent); color:var(--on-accent); }
  .nav { display:flex; gap:2px; overflow-x:auto; scrollbar-width:none; }
  .nav::-webkit-scrollbar { display:none; }
  .nav button { border:0; background:transparent; color:var(--muted); display:flex; align-items:center; gap:7px; padding:7px 12px; border-radius:8px; font-weight:550; white-space:nowrap; }
  .nav button:hover { color:var(--ink); background:var(--surface2); }
  .nav button.active { color:var(--accent); background:var(--tint); }
  .nav-count { font-size:11px; line-height:18px; padding:0 7px; border-radius:999px; background:var(--surface2); color:var(--muted); }
  .nav button.active .nav-count { background:var(--surface); color:var(--accent); }
  .top-actions,.inline,.actions { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
  .top-actions { margin-left:auto; flex-wrap:nowrap; }
  .live-status { display:flex; gap:6px; align-items:center; font-size:11.5px; color:var(--muted); white-space:nowrap; }
  .dot { width:7px; height:7px; border-radius:50%; background:var(--muted); }
  .live-status.online .dot { background:var(--good); box-shadow:0 0 0 3px var(--good-bg); }
  .live-status.offline .dot { background:var(--bad); }
  .workspace { max-width:1180px; margin:0 auto; padding:26px 24px 110px; }
  .page-head { display:flex; align-items:baseline; gap:14px; margin-bottom:18px; flex-wrap:wrap; }
  h1 { font-size:22px; letter-spacing:-.4px; line-height:1.3; margin:0; font-weight:700; }
  .page-head p { margin:0; color:var(--muted); font-size:13px; }
  .metrics { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; margin-bottom:24px; }
  .metric { padding:14px 16px; background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); }
  .metric-label { color:var(--muted); font-size:12px; }
  .metric-value { font-size:26px; font-weight:700; letter-spacing:-.5px; line-height:1.2; margin-top:2px; font-variant-numeric:tabular-nums; }
  .panel { background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); }
  .workflow { padding:16px 20px; margin-bottom:18px; }
  .panel-heading { display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; }
  .panel-heading h2 { font-size:13px; margin:0; font-weight:650; }
  .workflow-message { font-size:12px; color:var(--muted); }
  .steps { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); margin-top:14px; gap:8px; }
  .step { font-size:11px; color:var(--muted); display:flex; align-items:center; gap:6px; }
  .step-number { flex-shrink:0; width:22px; height:22px; border:1px solid var(--line); border-radius:50%; display:grid; place-items:center; font-size:10px; font-weight:650; }
  .step.running { color:var(--accent); font-weight:650; }.step.running .step-number { border-color:var(--accent); box-shadow:0 0 0 3px var(--tint); }
  .step.done { color:var(--good); }.step.done .step-number { background:var(--good-bg); border-color:transparent; }
  .step.failed { color:var(--bad); }.step.failed .step-number { background:var(--bad-bg); border-color:transparent; }
  .step.skipped { opacity:.65; }.step.skipped .step-number { border-style:dashed; }
  .notice { border:1px solid var(--line); border-left:3px solid var(--warn); background:var(--warn-bg); padding:11px 14px; border-radius:8px; margin-bottom:16px; font-size:12.5px; }
  .notice.error { border-left-color:var(--bad); background:var(--bad-bg); }
  code { font-family:Consolas,monospace; font-size:12px; background:var(--surface2); padding:3px 7px; border:1px solid var(--line); border-radius:5px; overflow-wrap:anywhere; }
  .section-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:0 0 12px; }
  .section-heading h2 { margin:0; font-size:15px; font-weight:650; }
  .section-note { color:var(--muted); font-size:12.5px; margin:0 0 14px; }
  .tabs { display:flex; gap:2px; border-bottom:1px solid var(--line); margin-bottom:14px; overflow-x:auto; scrollbar-width:none; }
  .tabs::-webkit-scrollbar { display:none; }
  .tab { border:0; border-bottom:2px solid transparent; margin-bottom:-1px; background:transparent; padding:8px 12px; font-size:13px; color:var(--muted); font-weight:550; white-space:nowrap; }
  .tab:hover { color:var(--ink); }
  .tab.active { color:var(--ink); border-bottom-color:var(--accent); }
  .tab span { margin-left:6px; font-size:11px; color:var(--muted); background:var(--surface2); border-radius:999px; padding:0 6px; }
  .filters { display:flex; align-items:center; gap:8px; margin-bottom:12px; flex-wrap:wrap; }
  .search-wrap { display:flex; align-items:center; gap:8px; flex:1; min-width:200px; min-height:34px; padding:0 10px; color:var(--muted); border:1px solid var(--line); border-radius:8px; background:var(--surface); }
  .search-wrap:focus-within { border-color:var(--accent); }
  .search-wrap input { border:0; width:100%; background:transparent; color:var(--ink); padding:6px 0; }
  .search-wrap input:focus-visible { outline:none; }
  select,input[type="date"],input[type="datetime-local"],textarea { border:1px solid var(--line); border-radius:8px; background:var(--surface); color:var(--ink); padding:7px 10px; font-size:12.5px; }
  select { min-height:34px; }
  .filters select { max-width:170px; }.filters .check { font-size:12.5px; color:var(--muted); display:flex; gap:6px; align-items:center; white-space:nowrap; }
  input[type="checkbox"] { accent-color:var(--accent); width:15px; height:15px; cursor:pointer; margin:0; }
  .list-heading { display:flex; align-items:center; justify-content:space-between; color:var(--muted); font-size:12px; margin-bottom:10px; gap:12px; }
  .select-label { display:flex; align-items:center; gap:7px; }
  .cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:12px; }
  .job-card { padding:16px; display:flex; flex-direction:column; gap:10px; transition:border-color .12s; }
  .job-card:hover { border-color:var(--line-strong); }
  .job-card.selected { border-color:var(--accent); box-shadow:0 0 0 1px var(--accent); }
  .card-head { display:flex; gap:10px; align-items:flex-start; }
  .card-head > div { flex:1; min-width:0; }
  .card-company { font-size:12px; color:var(--muted); }
  .card-title { border:0; padding:0; background:none; color:var(--ink); font-size:14px; font-weight:650; line-height:1.4; text-align:left; display:block; }
  .card-title:hover { color:var(--accent); }
  .card-check { margin-top:3px; }
  .card-meta { display:flex; gap:8px; align-items:center; flex-wrap:wrap; font-size:12px; color:var(--muted); }
  .tag { display:inline-flex; align-items:center; background:var(--surface2); color:var(--muted); padding:2px 7px; border-radius:5px; font-size:11px; }
  .badge { display:inline-flex; align-items:center; padding:2px 8px; border-radius:999px; font-size:11px; font-weight:600; background:var(--tint); color:var(--accent); }
  .badge.good { background:var(--good-bg); color:var(--good); }.badge.warn { background:var(--warn-bg); color:var(--warn); }.badge.bad { background:var(--bad-bg); color:var(--bad); }
  .match { margin-left:auto; font-weight:650; color:var(--good); font-variant-numeric:tabular-nums; }
  .card-reason { color:var(--muted); font-size:12.5px; margin:0; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .card-reason.flag { color:var(--warn); }
  .card-actions { display:flex; gap:6px; align-items:center; flex-wrap:wrap; margin-top:auto; padding-top:10px; border-top:1px solid var(--line); }
  .card-actions .btn { min-height:30px; padding:4px 10px; font-size:12px; }
  .card-actions .details { margin-left:auto; }
  .empty { text-align:center; padding:40px 24px; border:1px dashed var(--line); border-radius:var(--radius); color:var(--muted); background:var(--surface); }
  .empty h3 { color:var(--ink); font-size:15px; margin:0 0 4px; }.empty p { font-size:12.5px; margin:0 auto 14px; max-width:380px; }
  .table-wrap { overflow-x:auto; border:1px solid var(--line); border-radius:var(--radius); background:var(--surface); }
  table { border-collapse:collapse; width:100%; min-width:760px; } th,td { padding:11px 14px; border-bottom:1px solid var(--line); text-align:left; vertical-align:middle; }
  th { font-size:11px; letter-spacing:.3px; text-transform:uppercase; color:var(--muted); font-weight:600; }
  td { font-size:12.5px; } tbody tr:hover { background:var(--surface2); } tbody tr:last-child td { border-bottom:0; }
  .pagination { display:flex; justify-content:flex-end; align-items:center; gap:10px; color:var(--muted); font-size:12px; margin-top:16px; }
  .board { display:flex; gap:12px; overflow-x:auto; padding-bottom:14px; }
  .board-column { flex:0 0 220px; background:var(--surface2); border:1px solid var(--line); border-radius:var(--radius); padding:12px; min-height:220px; }
  .board-column.drop-ready { border-color:var(--accent); background:var(--tint); }
  .board-column h3 { display:flex; justify-content:space-between; text-transform:capitalize; margin:0 0 12px; font-size:12.5px; }.board-column h3 span { color:var(--muted); font-weight:500; }
  .board-card { width:100%; border:1px solid var(--line); border-radius:8px; background:var(--surface); color:var(--ink); text-align:left; padding:11px 12px; margin-bottom:8px; }
  .board-card strong { display:block; font-size:11.5px; color:var(--muted); margin-bottom:3px; font-weight:550; }.board-card p { font-size:12.5px; margin:0 0 8px; font-weight:600; }.board-card:hover { border-color:var(--accent); }
  .board-card[draggable="true"] { cursor:grab; }
  .board-card.dragging { opacity:.45; }
  .board-empty { text-align:center; color:var(--muted); font-size:11.5px; padding:24px 0; }
  .health-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }.health-card { padding:18px 20px; }.health-card h3 { margin:0 0 10px; font-size:13.5px; }
  .health-row { display:flex; justify-content:space-between; gap:12px; font-size:12.5px; padding:9px 0; border-bottom:1px solid var(--line); }.health-row:last-child { border-bottom:0; }.health-row span:first-child { color:var(--muted); }
  .health-error { border-top:1px solid var(--line); padding:10px 0; font-size:12.5px; }.health-error p { color:var(--bad); font-size:11.5px; margin:4px 0; overflow-wrap:anywhere; }
  .batch { position:fixed; bottom:20px; left:50%; transform:translateX(-50%); display:flex; align-items:center; gap:8px; padding:10px 14px; background:var(--surface); color:var(--ink); border:1px solid var(--line); border-radius:12px; box-shadow:var(--shadow); z-index:30; }
  .batch strong { font-size:12.5px; margin-right:6px; white-space:nowrap; }
  dialog { color:var(--ink); background:var(--surface); border:1px solid var(--line); border-radius:12px; padding:22px; max-width:460px; width:calc(100% - 30px); box-shadow:var(--shadow); overscroll-behavior:contain; }
  dialog::backdrop { background:#101b3259; backdrop-filter:blur(2px); }
  dialog h2 { font-size:17px; margin:0 0 8px; } dialog p { color:var(--muted); font-size:13px; }.dialog-actions { display:flex; justify-content:flex-end; gap:8px; margin-top:18px; }
  #detail { margin:0 0 0 auto; height:100dvh; max-height:100dvh; width:min(640px,95vw); max-width:none; border-radius:0; border-width:0 0 0 1px; padding:0; }
  .drawer-header { padding:20px 24px 14px; border-bottom:1px solid var(--line); position:sticky; top:0; z-index:2; background:var(--surface); }
  .drawer-top { display:flex; align-items:center; justify-content:space-between; color:var(--muted); font-size:11px; margin-bottom:10px; }
  .drawer-header h2 { font-size:19px; letter-spacing:-.3px; line-height:1.3; margin:0 0 4px; }.drawer-sub { color:var(--muted); font-size:12.5px; }
  .drawer-body { padding:20px 24px; }.drawer-body h3 { font-size:12px; letter-spacing:.3px; text-transform:uppercase; color:var(--muted); margin:22px 0 8px; font-weight:600; }.drawer-body h3:first-child { margin-top:0; }
  .next-step { font-size:12.5px; color:var(--muted); margin:10px 0 0; }
  .description { white-space:pre-wrap; font-size:12.5px; line-height:1.7; overflow-wrap:anywhere; border:1px solid var(--line); background:var(--surface2); border-radius:8px; padding:12px 14px; }
  .reason-list { padding-left:18px; font-size:12.5px; color:var(--muted); margin:0; }.reason-list li { margin:4px 0; }.reason-list.flags { color:var(--warn); }
  .contact { padding:12px; border:1px solid var(--line); border-radius:8px; margin:8px 0; }.contact strong { font-size:12.5px; }.contact p { margin:4px 0 8px; font-size:12px; color:var(--muted); }
  .timeline { padding-left:12px; border-left:2px solid var(--line); }.event { margin:0 0 12px; font-size:12.5px; }.event small { display:block; color:var(--muted); font-size:11px; }.event p { margin:2px 0; white-space:pre-wrap; overflow-wrap:anywhere; }
  .drawer-form { padding:0 24px 20px; }.drawer-form label { display:block; font-size:12.5px; font-weight:600; margin-bottom:6px; }.drawer-form textarea { width:100%; min-height:80px; resize:vertical; margin-bottom:6px; }.drawer-form small { display:block; color:var(--muted); font-size:11px; margin-bottom:10px; }
  .drawer-form .inline select { flex:1; }.drawer-form + .drawer-form { border-top:1px solid var(--line); padding-top:18px; }
  .record-form label { display:block; margin:12px 0 5px; font-size:12.5px; font-weight:600; }
  .record-form input:not([type="checkbox"]), .record-form select, .record-form textarea { width:100%; padding:8px 10px; border:1px solid var(--line); border-radius:8px; background:var(--surface); color:var(--ink); }
  .record-form textarea { min-height:80px; resize:vertical; }
  .record-form .check-line { display:flex; gap:9px; align-items:flex-start; font-weight:400; }
  .record-form .check-line input { flex-shrink:0; margin-top:4px; }
  #handoff-text { width:100%; min-height:150px; resize:vertical; margin:10px 0; }
  #handoff-status, #record-error { font-size:12.5px; color:var(--muted); }
  #record-error { color:var(--bad); }
  #record-dialog, #handoff-dialog { max-height:90dvh; overflow-y:auto; }
  #toast { position:fixed; bottom:22px; right:22px; background:var(--ink); color:var(--surface); border-radius:9px; padding:12px 16px; box-shadow:var(--shadow); max-width:420px; font-size:12.5px; z-index:100; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  @media(max-width:960px) { .metrics { grid-template-columns:repeat(2,1fr); }.health-grid { grid-template-columns:1fr; }.steps { grid-template-columns:repeat(4,1fr); gap:10px; } }
  @media(max-width:760px) { .topbar-inner { flex-wrap:wrap; padding:8px 14px; gap:8px; min-height:0; }.nav { order:3; width:100%; }.workspace { padding:18px 14px 110px; }.metric-value { font-size:22px; }.steps { grid-template-columns:repeat(3,1fr); }.cards { grid-template-columns:1fr; }.batch { width:calc(100% - 24px); flex-wrap:wrap; }#toast { right:12px; bottom:90px; max-width:calc(100% - 24px); }.filters select { max-width:100%; flex:1; }.drawer-header { padding:16px; }.drawer-body { padding:16px; }.drawer-form { padding:0 16px 16px; } }
  @media(prefers-reduced-motion:reduce) { * { transition:none!important; scroll-behavior:auto!important; } }
</style>
</head>
<body>
<header class="topbar">
  <div class="topbar-inner">
    <div class="brand"><span class="brand-mark" data-icon="compass"></span>{{ title }}</div>
    <nav class="nav" aria-label="Dashboard sections">
      <button data-view="today">Today<span class="nav-count" id="today-count">0</span></button>
      <button data-view="jobs">All jobs<span class="nav-count" id="jobs-count">0</span></button>
      <button data-view="pipeline">Pipeline</button>
      <button data-view="health">Health</button>
    </nav>
    <div class="top-actions">
      <span id="connection" class="live-status" role="status"><span class="dot"></span><span id="connection-text">Connecting</span></span>
      <button class="btn" id="refresh"><i data-icon="refresh"></i>Refresh</button>
      <button class="btn icon-btn" id="theme" aria-label="Toggle dark mode" title="Toggle dark mode"><i data-icon="moon"></i></button>
    </div>
  </div>
</header>
<main class="workspace">
  <div class="page-head"><h1 id="view-title">Today</h1><p id="view-subtitle"></p></div>
  <div id="connection-error" class="notice error" role="alert" hidden></div>
  <section class="metrics" id="metrics" aria-label="Your job search at a glance"></section>
  <section id="list-section">
    <div class="section-heading"><h2 id="list-title">Action queue</h2><div class="inline" role="group" aria-label="Job layout"><button class="btn icon-btn ghost" data-layout="cards" aria-label="Card view" title="Card view"><i data-icon="grid"></i></button><button class="btn icon-btn ghost" data-layout="table" aria-label="Table view" title="Table view"><i data-icon="list"></i></button></div></div>
    <div id="queue-tabs" class="tabs" role="tablist" aria-label="Action queue"></div>
    <div class="filters">
      <label class="search-wrap"><i data-icon="search"></i><span class="sr-only">Search jobs</span><input id="q" type="search" placeholder="Search company, role or location" autocomplete="off"></label>
      <label class="sr-only" for="location-filter">Location</label><select id="location-filter"><option value="">All locations</option></select>
      <label class="sr-only" for="st">Status</label><select id="st"><option value="">All statuses</option></select>
      <label class="sr-only" for="min-score">Minimum score</label><select id="min-score"><option value="0">Any score</option><option value="60">Score 60+</option><option value="70">Score 70+</option><option value="80">Score 80+</option><option value="90">Score 90+</option></select>
      <label class="sr-only" for="sort">Sort jobs</label><select id="sort"><option value="score">Best match first</option><option value="recent">Recently discovered</option><option value="company">Company A–Z</option></select>
      <label class="check"><input type="checkbox" id="remote-only"> Remote only</label>
      <button class="btn ghost" id="clear-filters">Reset</button>
    </div>
    <div class="list-heading"><label class="select-label"><input id="select-page" type="checkbox" aria-label="Select actionable jobs on this page"><span>Select page</span></label><span id="result-count"></span></div>
    <div id="decide" aria-live="polite"></div>
    <div class="pagination"><span id="page-info"></span><button class="btn" id="previous">Previous</button><button class="btn" id="next">Next</button></div>
  </section>
  <section id="pipeline-section" hidden><p class="section-note" id="board-help">Drag a card to record a confirmed update, or open it for the status controls. Moves never submit applications.</p><div id="board" class="board"></div></section>
  <section id="health-section" hidden>
    <section class="panel workflow" id="workflow"><div class="panel-heading"><h2>Morning run</h2><span class="workflow-message" id="workflow-message">Run /jobs-day in Claude Code to begin.</span></div><div id="steps" class="steps"></div></section>
    <div id="health-notice" class="notice" hidden></div>
    <div id="health-grid" class="health-grid"></div>
  </section>
</main>
<div id="batch" class="batch" hidden><strong id="selected-count"></strong><button class="btn primary" data-batch="approve">Approve selected</button><button class="btn" data-batch="skip">Skip</button><button class="btn icon-btn ghost" id="clear-selection" aria-label="Clear selection"><i data-icon="close"></i></button></div>
<dialog id="detail" aria-labelledby="detail-title"><div class="drawer-header"><div class="drawer-top"><span id="detail-id">JOB DETAIL</span><button class="btn icon-btn ghost" id="close-detail" aria-label="Close job details"><i data-icon="close"></i></button></div><h2 id="detail-title">Loading job</h2><div class="drawer-sub" id="detail-subtitle"></div></div><div class="drawer-body" id="detail-main"></div><form class="drawer-form" id="note-form"><label for="note-text">Keep a note</label><textarea id="note-text" maxlength="2000" placeholder="A conversation, a question, or something to remember…"></textarea><small>Notes are saved to this job's local history.</small><button class="btn primary" type="submit">Save note</button></form><form class="drawer-form" id="status-form" hidden><label for="status-select">Record verified progress</label><div class="inline"><select id="status-select" aria-label="New application status"></select></div><textarea id="status-note" maxlength="2000" placeholder="What confirmed this change?" style="margin-top:9px"></textarea><small>This records an update only. It never submits an application.</small><button class="btn" type="submit">Record status</button></form></dialog>
<dialog id="confirm-dialog" aria-labelledby="confirm-title"><form id="confirm-form"><h2 id="confirm-title"></h2><p id="confirm-message"></p><div class="dialog-actions"><button type="button" class="btn" id="cancel-confirm">Cancel</button><button type="submit" class="btn primary" id="confirm-button">Confirm</button></div></form></dialog>
<dialog id="record-dialog" aria-labelledby="record-title"><form id="record-form" class="record-form">
  <h2 id="record-title"></h2><p id="record-context"></p><p id="record-explanation"></p>
  <div id="record-date-field"><label for="record-at">When did it happen?</label><input id="record-at" type="datetime-local" required></div>
  <div id="record-channel-field"><label for="record-channel">Channel</label><select id="record-channel"></select></div>
  <div id="record-contact-field"><label for="record-contact">Who did you ask?</label><select id="record-contact"></select><label for="record-contact-name">Name, if not listed</label><input id="record-contact-name" maxlength="150" autocomplete="off"></div>
  <div id="record-reference-field"><label for="record-reference">Confirmation link or reference (optional)</label><input id="record-reference" maxlength="2048" autocomplete="off"></div>
  <label for="record-note">What confirmed this?</label><textarea id="record-note" maxlength="2000" required placeholder="For example: I saw the confirmation page, or I sent the message on LinkedIn."></textarea>
  <label class="check-line"><input id="record-confirm" type="checkbox" required><span id="record-confirm-label"></span></label>
  <p id="record-error" role="alert"></p>
  <div class="dialog-actions"><button type="button" class="btn" id="record-cancel">Cancel</button><button type="submit" class="btn primary" id="record-save">Save record</button></div>
</form></dialog>
<dialog id="handoff-dialog" aria-labelledby="handoff-title"><h2 id="handoff-title">Continue in your Claude Code session</h2><p>This page does not launch Claude or execute commands. Copy this prompt and paste it into your Claude Code terminal.</p><label class="sr-only" for="handoff-text">Prompt to copy</label><textarea id="handoff-text" readonly></textarea><p id="handoff-status" role="status" aria-live="polite"></p><div class="dialog-actions"><button class="btn" id="handoff-close">Close</button><button class="btn primary" id="handoff-copy">Copy prompt</button></div></dialog>
<div id="toast" role="status" hidden></div>
<script id="jobs-data" type="application/json">{{ {'rows': rows, 'kpis': kpis, 'funnel': funnel, 'kanban': kanban, 'follow_ups': follow_ups, 'generated_at': generated_at} | tojson }}</script>
<script id="live-cfg" type="application/json">{{ {'live': live|default(false), 'options': live_cfg|default({})} | tojson }}</script>
<script>
(function () {
  'use strict';
  const $ = id => document.getElementById(id);
  const cfg = JSON.parse($('live-cfg').textContent);
  const REFRESH_MS = (cfg.options.refresh_seconds || 5) * 1000;
  const PAGE_SIZE = cfg.options.page_size || 24;
  const BATCH_LIMIT = cfg.options.batch_limit || 50;
  const AUTH_KEY = 'jobhunt-access', PREF_KEY = 'jobhunt-view', THEME_KEY = 'jobhunt-theme';
  const ACCESS_HINT = 'This tab’s access has expired. Run "uv run jobhunt serve" in the JobHunt terminal to open an authenticated tab.';
  const PRE_REVIEW = ['discovered','filtered','scored','shortlisted','approved'];
  const GROUP_LABELS = {to_review:'Needs review',to_prepare:'Approved',ready_to_apply:'Prepared for assistant',referral_recommended:'Referral recommended',awaiting_referral:'Awaiting referral',referral_deadline:'Referral deadline passed',unanswered_questions:'Optional preparation',blocked:'Assistant blocked',eligibility_review:'Eligibility not verified',referral_received:'Referral received',referral_declined:'Referral declined'};
  const TABS = [['review','Review',['to_review']],['ready','Approved',['ready_to_apply','to_prepare']],['referrals','Referrals',['referral_recommended','awaiting_referral','referral_deadline']],['input','Verification & preparation',['eligibility_review','blocked','unanswered_questions']]];
  const DEFAULT_STAGES = [['health','Setup'],['sync','Inbox'],['scan','Find & score'],['review','Review'],['applications','Applications'],['referrals','Referrals'],['finish','Summary']];
  const ICONS = {compass:'M12 3 3 21l9-5 9 5-9-18Z M12 3v13',search:'M10.5 3a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15 M16 16l5 5',refresh:'M20 7V3l-3 3a8 8 0 1 0 2 12 M20 7h-5',moon:'M20 15A8 8 0 0 1 9 4a8 8 0 1 0 11 11Z',grid:'M3 3h7v7H3Z M14 3h7v7h-7Z M3 14h7v7H3Z M14 14h7v7h-7Z',list:'M8 5h13 M8 12h13 M8 19h13 M3 5h1 M3 12h1 M3 19h1',close:'M6 6l12 12 M18 6 6 18',check:'m5 12 4 4L19 6'};
  const esc = value => String(value == null ? '' : value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const icon = name => '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="'+ICONS[name]+'"/></svg>';
  const human = value => String(value || '').replace(/_/g,' ');
  function readStore(storage,key,fallback) { try { return JSON.parse(storage.getItem(key)) || fallback; } catch (_) { return fallback; } }
  function saveStore(storage,key,value) { try { storage.setItem(key,JSON.stringify(value)); } catch (_) {} }
  let state = JSON.parse($('jobs-data').textContent), prefs = readStore(localStorage,PREF_KEY,{});
  let view = cfg.live ? (prefs.view || 'today') : 'jobs', tab = prefs.tab || 'review', layout = prefs.layout || 'cards';
  let pageNumber=1, shown=[], filtered=[], busy=false, online=!cfg.live, refreshing=false, timer=null, lastSuccess=null, filtersRestored=false;
  let detailId=null, detailData=null, detailContacts=[], detailVersion=0, detailLoading=false, pendingAction=null;
  let recordContext=null, recording=false, draggedId=null, refreshQueued=false;
  const POST_APPLICATION=['applied','screening','interview','offer','rejected','withdrawn','ghosted'];
  const selected=new Set(), noteDrafts=new Map(), statusDrafts=new Map();
  const hash = new URLSearchParams(location.hash.slice(1)), query = new URLSearchParams(location.search);
  let token = hash.get('t') || query.get('t') || readStore(sessionStorage,AUTH_KEY,'');
  let fillCloseArmed=null, fillTimer=null;
  const fillRequestIds=new Map();
  if (token) { saveStore(sessionStorage,AUTH_KEY,token); if (hash.has('t') || query.has('t')) history.replaceState(null,'',location.pathname); }
  function safeUrl(value) { try { const u=new URL(value); return ['http:','https:'].includes(u.protocol) ? u.href : ''; } catch (_) { return ''; } }
  function link(value,label) { const url=safeUrl(value); return url ? '<a class="btn" href="'+esc(url)+'" target="_blank" rel="noopener noreferrer">'+esc(label)+'</a>' : ''; }
  function localDate(d) { return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
  function stamp(value) { const d=new Date(value); return value && !isNaN(d) ? d.toLocaleString([], {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : 'Not yet'; }
  function badge(value,kind='') { const text=human(value); return '<span class="badge '+kind+'">'+esc(text.charAt(0).toUpperCase()+text.slice(1))+'</span>'; }
  function rowFor(id) { const row=(state.rows || []).find(r=>r.id===Number(id)); if(row) return row; const review=((state.plan||{}).needs_input?.eligibility_review||[]).find(r=>r.job_id===Number(id)); return review ? {...review,id:review.job_id,group:'eligibility_review'} : undefined; }
  function canAct(row,action) {
    if (!cfg.live || !token || !online || !row || ['pending','unknown'].includes(row.submission_state)) return false;
    if (row.snooze_until && new Date(row.snooze_until)>new Date()) return false;
    if (row.route==='referral_pending') return false;
    return action==='approve' ? ['discovered','scored','shortlisted'].includes(row.status) : action==='skip' && PRE_REVIEW.includes(row.status);
  }
  function selectable(row) { return canAct(row,'skip'); }
  function empty(title,text,button=false) { return '<div class="empty"><h3>'+esc(title)+'</h3><p>'+esc(text)+'</p>'+(button?'<button class="btn" data-view="jobs">Browse all jobs</button>':'')+'</div>'; }
  function groupItems(key) {
    const p=state.plan||{}, items=(p[key] || (p.needs_input||{})[key] || []);
    return items.map(i=>({...rowFor(i.job_id),...i,id:i.job_id,group:key}));
  }
  function tabItems(key) {
    const planned=new Map(Object.keys(GROUP_LABELS).flatMap(groupItems).map(r=>[r.id,r]));
    if(key==='ready') return (state.rows||[]).filter(r=>r.status==='approved').map(r=>({...r,...planned.get(r.id)}));
    if(key==='review') return (state.rows||[]).filter(r=>r.status==='shortlisted' && (!r.snooze_until || new Date(r.snooze_until)<=new Date()) && planned.get(r.id)?.route!=='referral_pending').map(r=>({...r,...planned.get(r.id)}));
    const items=(TABS.find(t=>t[0]===key)||TABS[0])[2].flatMap(groupItems);
    if(key==='referrals') {
      const requests=(state.tracking||{}).referrals||[];
      for(const request of requests) {
        const related=requests.filter(r=>r.job_id===request.job_id);
        const group=related.some(r=>r.referral_outcome==='completed')?'referral_received':related.some(r=>r.referral_outcome==='pending')?'awaiting_referral':'referral_declined';
        items.push({...rowFor(request.job_id),id:request.job_id,company:request.job_company,title:request.job_title,group,referral_summary:related.map(r=>r.contact_name+': '+human(r.referral_outcome)).join(' · ')});
      }
    }
    return [...new Map(items.map(r=>[r.id,r])).values()];
  }
  function currentItems() { return view==='today' ? tabItems(tab) : (state.rows||[]); }
  function persist() { prefs={view,tab,layout,q:$('q').value,location:filtersRestored?$('location-filter').value:(prefs.location||''),status:filtersRestored?$('st').value:(prefs.status||''),min:$('min-score').value,sort:$('sort').value,remote:$('remote-only').checked}; saveStore(localStorage,PREF_KEY,prefs); }
  function matches(row) {
    const search=[$('q').value.trim().toLowerCase(),$('location-filter').value,$('st').value];
    return (!search[0] || [row.company,row.title,row.location].join(' ').toLowerCase().includes(search[0])) &&
      (!search[1] || row.location===search[1]) && (!search[2] || row.status===search[2]) &&
      (Number($('min-score').value)===0 || (row.score!=null && row.score>=Number($('min-score').value))) && (!$('remote-only').checked || row.is_remote);
  }
  function sortRows(a,b) {
    const sort=$('sort').value;
    if (sort==='company') return String(a.company).localeCompare(String(b.company));
    if (sort==='recent') return String(b.discovered_at||'').localeCompare(String(a.discovered_at||''));
    return (b.score==null?-1:b.score)-(a.score==null?-1:a.score) || b.id-a.id;
  }
  function actionButton(row,action,label) {
    if(!canAct(row,action)) return '';
    return '<button class="btn '+(action==='approve'?'primary':'ghost')+'" data-action="'+action+'" data-id="'+row.id+'" '+(busy?'disabled':'')+'>'+label+'</button>';
  }
  function stepHelp(row) {
    if(row.group==='eligibility_review' || row.status==='filtered') return 'Not shortlisted. Verify India-eligible remote work or both visa sponsorship and relocation support on the official posting.';
    if(['pending','unknown'].includes(row.submission_state)) return 'Submission outcome unresolved. Verify it before trying again; record it here if confirmed.';
    if(POST_APPLICATION.includes(row.status)) return 'Application recorded. Open details to update verified progress.';
    if(row.snooze_until && new Date(row.snooze_until)>new Date()) return 'On hold until '+stamp(row.snooze_until)+'. You can still record an action you already completed.';
    if(row.status==='approved' && row.score==null) return 'Approved for manual tracking. This job is not scored for automation; you can still apply manually.';
    if(row.status==='approved') return 'Approved. Apply manually and record it here, or optionally prepare with Claude.';
    if(row.status==='discovered' || row.status==='scored') return 'Manual approval is available. Automatic submission still requires scoring and preparation.';
    return 'Approve to keep this opportunity, or record an application or referral you already completed.';
  }
  function appliedButton(row,full) {
    // Approving and recording an application are sequential steps, so a card shows one at a
    // time: Approve first, then I applied. The detail drawer keeps both for manual records.
    if(!cfg.live || !token || !online) return '';
    if(POST_APPLICATION.includes(row.status) || !(full || row.status==='approved')) return '';
    return '<button class="btn '+(row.status==='approved'?'primary':'')+'" data-record="application" data-job="'+row.id+'" '+(busy?'disabled':'')+'>I applied</button>';
  }
  function referralButton(row) {
    if(!cfg.live || !token || !online) return '';
    return '<button class="btn ghost" data-record="referral" data-job="'+row.id+'" '+(busy?'disabled':'')+'>Referral requested</button>';
  }
  // One order everywhere: the step forward, then the record of a step already taken, then the
  // way out. Undecided reads Approve then Skip; approved reads I applied then Skip.
  function decisionButtons(row,full=false) {
    return actionButton(row,'approve','Approve')+appliedButton(row,full)+actionButton(row,'skip','Skip')+(full?referralButton(row):'');
  }
  function card(row) {
    const label=GROUP_LABELS[row.group] || human(row.status);
    const why=(row.why||[]).slice(0,2).join(' · ') || row.description || 'Awaiting a complete match review.';
    const reason=row.referral_summary || (row.route && row.route!=='apply' ? row.route_reason : why);
    const check=selectable(row)?'<input class="card-check" type="checkbox" data-select="'+row.id+'" aria-label="Select '+esc(row.company)+' job '+row.id+'" '+(selected.has(row.id)?'checked':'')+'>':'';
    const flag=(row.red_flags||[]).length?'<p class="card-reason flag">'+esc(row.red_flags[0])+'</p>':'';
    return '<article class="panel job-card '+(selected.has(row.id)?'selected':'')+'"><div class="card-head"><div><div class="card-company">'+esc(row.company)+'</div><button class="card-title" data-detail="'+row.id+'">'+esc(row.title)+'</button></div>'+check+'</div><div class="card-meta"><span>'+esc(row.location||'Location unstated')+'</span>'+badge(label,row.group==='blocked'?'bad':row.group==='ready_to_apply'?'good':'')+'<span class="match">'+(row.score==null?'Not scored':esc(row.score)+' / 100')+'</span></div><p class="card-reason">'+esc(String(reason||'').slice(0,210))+'</p>'+flag+'<div class="card-actions">'+decisionButtons(row)+'<button class="btn ghost details" data-detail="'+row.id+'">Details</button></div></article>';
  }
  function table(rows) {
    return '<div class="table-wrap"><table id="jobs"><thead><tr><th></th><th>Company / role</th><th>Location</th><th>Match</th><th>Status</th><th>Discovered</th><th></th></tr></thead><tbody>'+rows.map(r=>'<tr><td>'+(selectable(r)?'<input type="checkbox" data-select="'+r.id+'" aria-label="Select job '+r.id+'" '+(selected.has(r.id)?'checked':'')+'>':'')+'</td><td><strong>'+esc(r.company)+'</strong><button class="card-title" data-detail="'+r.id+'">'+esc(r.title)+'</button></td><td>'+esc(r.location||'Unstated')+'</td><td>'+(r.score==null?'—':r.score)+'</td><td>'+badge(GROUP_LABELS[r.group]||r.status)+'</td><td>'+stamp(r.discovered_at)+'</td><td><button class="btn" data-detail="'+r.id+'">Details</button></td></tr>').join('')+'</tbody></table></div>';
  }
  function renderList() {
    const candidates=currentItems().filter(matches).sort(sortRows); filtered=candidates;
    const pages=Math.max(1,Math.ceil(candidates.length/PAGE_SIZE)); pageNumber=Math.min(pageNumber,pages);
    shown=candidates.slice((pageNumber-1)*PAGE_SIZE,pageNumber*PAGE_SIZE);
    $('result-count').textContent=candidates.length+' matching '+(candidates.length===1?'job':'jobs');
    $('page-info').textContent='Page '+pageNumber+' of '+pages;
    $('previous').disabled=pageNumber<=1; $('next').disabled=pageNumber>=pages;
    $('decide').innerHTML=shown.length ? (layout==='cards'?'<div class="cards">'+shown.map(card).join('')+'</div>':table(shown)) : empty(view==='today'?'A clear queue':'No jobs match these filters',view==='today'?'Nothing is waiting for a decision. New matches appear here after the next scan.':'Try a different search or reset the filters.',view==='today');
    document.querySelectorAll('[data-layout]').forEach(b=>b.classList.toggle('active',b.dataset.layout===layout));
    const eligible=shown.filter(selectable); $('select-page').disabled=!eligible.length || busy;
    $('select-page').checked=eligible.length>0 && eligible.every(r=>selected.has(r.id));
    $('select-page').indeterminate=eligible.some(r=>selected.has(r.id)) && !$('select-page').checked;
    renderBatch(); persist();
  }
  function renderBatch() {
    $('batch').hidden=!selected.size; $('selected-count').textContent=selected.size+' selected';
    document.querySelectorAll('[data-batch]').forEach(b=>b.disabled=busy || ![...selected].every(id=>canAct(rowFor(id),b.dataset.batch)));
  }
  function renderTabs() {
    $('queue-tabs').innerHTML=TABS.map(t=>'<button class="tab '+(tab===t[0]?'active':'')+'" data-tab="'+t[0]+'" role="tab" aria-selected="'+(tab===t[0])+'">'+t[1]+'<span>'+tabItems(t[0]).length+'</span></button>').join('');
  }
  function renderMetrics() {
    const f=state.funnel||{}, tracking=state.tracking||{};
    const metrics=[['review','To review',tabItems('review').length],['approved','Approved',f.approved||0],['active','Active applications',tracking.active_applications??((f.applied||0)+(f.screening||0)+(f.interview||0)+(f.offer||0))],['followups','Follow-ups due',tracking.follow_up_due_count??(state.follow_ups||[]).length]];
    $('metrics').innerHTML=metrics.map(m=>'<div class="metric" data-metric="'+m[0]+'"><div class="metric-label">'+m[1]+'</div><div class="metric-value">'+m[2]+'</div></div>').join('');
    $('today-count').textContent=new Set(TABS.flatMap(t=>tabItems(t[0])).map(r=>r.id)).size; $('jobs-count').textContent=(state.rows||[]).length;
  }
  function renderWorkflow() {
    const w=state.workflow||{}, stages=w.stages||DEFAULT_STAGES.map(s=>({id:s[0],label:s[1]}));
    $('steps').innerHTML=stages.map((s,i)=>{ const step=(w.steps||{})[s.id]||{}; return '<div class="step '+esc(step.state||'')+'" title="'+esc(step.message||human(step.state)||'Not started')+'"><span class="step-number">'+(step.state==='done'?icon('check'):step.state==='skipped'?'–':i+1)+'</span>'+esc(s.label)+'</div>'; }).join('');
    $('workflow-message').textContent=w.message || (w.status==='done'?'Run complete. Your tracker is up to date.':w.status==='failed'?'This run needs attention. Check failed stages.':'Run /jobs-day in Claude Code to begin.');
  }
  function renderBoard() {
    $('board').innerHTML=(state.kanban||[]).map(col=>'<div class="board-column" data-stage="'+esc(col.status)+'"><h3>'+esc(col.status)+' <span>'+col.count+'</span></h3>'+((col.cards||[]).map(r=>'<button class="board-card" data-detail="'+r.id+'" data-drag-job="'+r.id+'" draggable="'+(cfg.live && online && !busy && (rowFor(r.id)?.allowed_moves||[]).length>0)+'" aria-describedby="board-help"><strong>'+esc(r.company)+'</strong><p>'+esc(r.title)+'</p><span class="tag">'+esc(r.location)+'</span> <span class="match">'+(r.score==null?'':r.score)+'</span></button>').join('') || '<div class="board-empty">No jobs at this stage</div>')+(col.count>(col.cards||[]).length?'<div class="board-empty">Showing the top '+col.cards.length+' of '+col.count+'</div>':'')+'</div>').join('');
  }
  function followupMarkup() {
    const items=(state.tracking||{}).follow_ups || (state.follow_ups||[]);
    return items.map(r=>'<div class="health-row"><div>'+badge(r.kind==='referral'?'Referral follow-up':'Application follow-up')+(r.job_id?'<button class="card-title" data-detail="'+r.job_id+'">'+esc(r.company||r.job_company)+' · '+esc(r.title||r.job_title)+'</button>':'')+(r.contact_name?'<span class="card-company">'+esc(r.contact_name)+'</span>':'')+'</div><span>'+stamp(r.due_at||r.next_follow_up_at||r.last_activity_at)+'</span></div>').join('') || '<p class="card-reason">No follow-ups due yet. Reminders appear after an application or referral is recorded and its due date arrives.</p>';
  }
  function healthRow(label,value) { return '<div class="health-row"><span>'+esc(label)+'</span><span>'+esc(value)+'</span></div>'; }
  function renderHealth() {
    const h=(state.plan||{}).health||{}, p=(state.plan||{}).progress||{}, failures=h.sources_failed||[];
    const scheduled=h.last_scheduled_run||{};
