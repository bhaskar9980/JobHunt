    } catch(error) {
      $('record-error').textContent=error.message;
      if(error.status===409) { const latest=await api('/api/job?job_id='+job.id).catch(()=>null); if(latest) { context.job=latest; $('record-context').textContent='#'+job.id+' · Current status: '+human(latest.pipeline_status)+'. Review before saving again.'; } }
    } finally { recording=false; busy=false; $('record-save').disabled=false; $('record-cancel').disabled=false; await refresh(); }
  }
  function moveJob(id,target) {
    const row=rowFor(id); if(!row || row.status===target) return;
    if(!(row.allowed_moves||[]).includes(target)) return say('That move is not available. Open the job for its current status and valid actions.');
    if(target==='approved') return openAction('approve',[id]);
    if(target==='applied') return openRecord('application',id);
    return openRecord('status',id,{target});
  }
  function setTheme(theme) { document.documentElement.dataset.theme=theme; saveStore(localStorage,THEME_KEY,theme); $('theme').title=theme==='dark'?'Use light mode':'Use dark mode'; }
  document.addEventListener('click',event=>{
    const b=event.target.closest('button'); if(!b || b.disabled) return;
    if(b.dataset.view) setView(b.dataset.view);
    if(b.dataset.tab) { tab=b.dataset.tab; pageNumber=1; renderTabs(); renderList(); }
    if(b.dataset.layout) { layout=b.dataset.layout; renderList(); }
    if(b.dataset.detail) loadDetail(Number(b.dataset.detail));
    if(b.dataset.action) openAction(b.dataset.action,[Number(b.dataset.id)]);
    if(b.dataset.batch) openAction(b.dataset.batch,[...selected]);
    if(b.dataset.copy) copyText(b.dataset.copy);
    if(b.dataset.record) openRecord(b.dataset.record,Number(b.dataset.job),{contact:b.dataset.contact,outreach:Number(b.dataset.outreach),outcome:b.dataset.outcome});
    if(b.dataset.fill) startFill(Number(b.dataset.fill));
    if(b.dataset.fillResume) controlFill(Number(b.dataset.fillResume),b.dataset.run,'resume');
    if(b.dataset.fillClose) controlFill(Number(b.dataset.fillClose),b.dataset.run,'close');
    if(b.dataset.fillKeep) { fillCloseArmed=null; paintFill(); }
  });
  document.addEventListener('change',event=>{ if(event.target.dataset.select) { const id=Number(event.target.dataset.select); if(event.target.checked) selected.add(id); else selected.delete(id); renderList(); } });
  $('select-page').addEventListener('change',event=>{ shown.filter(selectable).forEach(r=>event.target.checked?selected.add(r.id):selected.delete(r.id)); renderList(); });
  $('q').addEventListener('input',()=>{ pageNumber=1; renderList(); });
  ['location-filter','st','min-score','sort','remote-only'].forEach(id=>$(id).addEventListener('change',()=>{pageNumber=1;renderList();}));
  $('clear-filters').onclick=()=>{ $('q').value=''; $('location-filter').value=''; $('st').value=''; $('min-score').value='0'; $('sort').value='score'; $('remote-only').checked=false; prefs={};pageNumber=1;renderList(); };
  $('previous').onclick=()=>{pageNumber--;renderList();}; $('next').onclick=()=>{pageNumber++;renderList();};
  $('clear-selection').onclick=()=>{selected.clear();renderList();}; $('refresh').onclick=refresh;
  $('theme').onclick=()=>setTheme(document.documentElement.dataset.theme==='dark'?'light':'dark');
  $('confirm-form').onsubmit=submitAction; $('cancel-confirm').onclick=()=>$('confirm-dialog').close();
  $('close-detail').onclick=()=>$('detail').close(); $('detail').addEventListener('close',()=>{detailId=null;detailData=null;detailVersion++;detailLoading=false;fillCloseArmed=null;clearTimeout(fillTimer);});
  $('note-form').onsubmit=saveNote; $('status-form').onsubmit=saveStatus;
  $('record-form').onsubmit=saveRecord; $('record-cancel').onclick=()=>$('record-dialog').close();
  $('record-dialog').addEventListener('cancel',event=>{if(recording) event.preventDefault();});
  $('record-contact').onchange=()=>{$('record-contact-name').required=!$('record-contact').value;};
  $('handoff-copy').onclick=copyPrompt; $('handoff-close').onclick=()=>$('handoff-dialog').close();
  $('board').addEventListener('dragstart',event=>{
    const card=event.target.closest('[data-drag-job]'); if(!card || busy || !online) { event.preventDefault(); return; }
    draggedId=Number(card.dataset.dragJob); clearTimeout(timer); card.classList.add('dragging');
    event.dataTransfer.setData('text/plain',String(draggedId)); event.dataTransfer.effectAllowed='move';
  });
  $('board').addEventListener('dragover',event=>{
    const column=event.target.closest('[data-stage]'); if(!column || draggedId===null) return;
    event.preventDefault();
    const allowed=(rowFor(draggedId)?.allowed_moves||[]).includes(column.dataset.stage);
    event.dataTransfer.dropEffect=allowed?'move':'none';
    document.querySelectorAll('.drop-ready').forEach(el=>el.classList.remove('drop-ready'));
    if(allowed) column.classList.add('drop-ready');
  });
  $('board').addEventListener('drop',event=>{
    const column=event.target.closest('[data-stage]'); if(!column || draggedId===null) return;
    event.preventDefault(); const id=draggedId; draggedId=null;
    document.querySelectorAll('.drop-ready,.dragging').forEach(el=>el.classList.remove('drop-ready','dragging'));
    moveJob(id,column.dataset.stage);
  });
  $('board').addEventListener('dragend',()=>{
    draggedId=null; document.querySelectorAll('.drop-ready,.dragging').forEach(el=>el.classList.remove('drop-ready','dragging')); refresh();
  });
  $('note-text').oninput=()=>{if(detailId) noteDrafts.set(detailId,$('note-text').value);}; $('status-note').oninput=()=>{if(detailId) statusDrafts.set(detailId,$('status-note').value);};
  document.addEventListener('visibilitychange',()=>{if(!document.hidden) refresh();});
  document.querySelectorAll('[data-icon]').forEach(el=>el.innerHTML=icon(el.dataset.icon));
  setTheme(readStore(localStorage,THEME_KEY,'light'));
  $('q').value=prefs.q||''; $('min-score').value=prefs.min||'0'; $('sort').value=prefs.sort||'score'; $('remote-only').checked=!!prefs.remote;
  render(); setView(view);
  if(cfg.live) { if(token) refresh(); else { $('connection-text').textContent='Access needed'; $('connection-error').hidden=false; $('connection-error').textContent=ACCESS_HINT; } }
  else { $('connection-text').textContent='Read-only snapshot · '+stamp(state.generated_at); $('refresh').hidden=true; $('select-page').closest('label').hidden=true; }
})();
</script>
</body>
</html>
