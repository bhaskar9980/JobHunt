# Copy to .env (gitignored). All values optional; defaults come from config/settings.yaml.
# Never put ATS or LinkedIn passwords here: logins happen by hand in the headed browser.

# Override the project root (defaults to the folder containing this file)
# JOBHUNT_ROOT=C:/path/to/JobHunt

# Override the SQLite path and data dir
# JOBHUNT_DB_PATH=C:/path/to/JobHunt/data/jobs.db
# JOBHUNT_DATA_DIR=C:/path/to/JobHunt/data

# Resume sources. Any config/settings.yaml paths.* key can be overridden as JOBHUNT_<KEY>.
# JOBHUNT_RESUME_PDF=C:/path/to/resume.pdf
# JOBHUNT_RESUME_TEX=C:/path/to/resume.tex
# JOBHUNT_ACCOMPLISHMENTS_MD=C:/path/to/accomplishments.md

# Browser behaviour for the Python fillers
# JOBHUNT_HEADLESS=0
# JOBHUNT_DRY_RUN=0

# Path to pdflatex (MiKTeX) for the optional --tailor-resume flag
# JOBHUNT_PDFLATEX=C:/path/to/MiKTeX/miktex/bin/x64/pdflatex.exe

# Log level
# JOBHUNT_LOG_LEVEL=INFO
